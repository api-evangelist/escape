{
  "opencollection": "1.0.0",
  "info": {
    "name": "Escape Public Asm Tags API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-ESCAPE-API-KEY",
      "value": "{{X-ESCAPE-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.escape.tech/v3/tags"
          },
          "docs": "List and search tags of the organization."
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public.escape.tech/v3/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a tag for the organization."
        },
        {
          "info": {
            "name": "Get a tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.escape.tech/v3/tags/:tagId",
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The tag ID"
              }
            ]
          },
          "docs": "Get a tag by ID."
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://public.escape.tech/v3/tags/:tagId",
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The tag ID"
              }
            ]
          },
          "docs": "Delete a tag from the organization."
        },
        {
          "info": {
            "name": "Update a tag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://public.escape.tech/v3/tags/:tagId/:tagId",
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The tag ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a tag name and/or color."
        }
      ]
    }
  ],
  "bundled": true
}