{
  "opencollection": "1.0.0",
  "info": {
    "name": "Escape Public Asm API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-ESCAPE-API-KEY",
      "value": "{{X-ESCAPE-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Asm",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Trigger ASM scans",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public.escape.tech/v3/asm/scans",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Trigger Attack Surface Management scans on assets matching the given filter. If no filter is provided, scans all monitored assets."
        }
      ]
    }
  ],
  "bundled": true
}